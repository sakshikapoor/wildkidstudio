---
import { Image } from 'astro:assets';

// The v2.0 desktop homepage, top to bottom, as one picture. The design is
// 1280 wide; the picture carries it at 76% of its width, with each section's
// own edge colour run out to either side, the way the page sits on a screen
// wider than it was drawn for. So the window can be large without the type
// inside it being large too.
import homepage from '../../assets/work/asci/homepage-desktop.png';

// Where the page's own sections begin and end, in the design's pixels. The
// picture is one file; these only say which stretch of it each band shows, so
// the sections can arrive one at a time the way they do on the live site.
const PAGE_H = 9988.3;
const cuts = [0, 100, 573, 1373, 2398, 3639, 4673, 5783, 7380, 8727, 9508, PAGE_H];
const bands = cuts.slice(0, -1).map((top, i) => ({
  top: (top / PAGE_H) * 100,
  height: ((cuts[i + 1] - top) / PAGE_H) * 100,
}));

const pageAlt =
  'The full ASCI homepage at desktop width: hero, flood-loss figures, hydrological risks, the NeoSar, FloodIQ and Climatica products, industries, articles, testimonials, contact form and footer';

const facts = [
  { label: 'Client', value: 'ASCI, Applied Science Innovations' },
  { label: 'Field', value: 'Physics-aware AI for flood risk' },
  { label: 'Scope', value: 'Website design' },
  { label: 'Products', value: 'NeoSar, FloodIQ, Climatica' },
];
---

<article class="as">
  <section class="as-brief">
    <p class="eyebrow" data-reveal="up">[1] THE BRIEF</p>
    <div class="as-brief__body">
      <p class="as-lede" data-reveal="up" style="--i: 1">
        ASCI builds physics-aware AI for flood risk — satellite interferometry, hydrological
        modelling, parametric insurance maths. Three products, sold to four kinds of buyer who
        share no vocabulary: infrastructure operators, real-estate portfolios, insurers and
        defence. The website had to make deep science legible without making it sound small.
      </p>
      <dl class="as-facts">
        {
          facts.map((fact, i) => (
            <div class="as-fact" data-reveal="up" style={`--i: ${i}`}>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>


  <section class="as-page">
    <p class="eyebrow" data-reveal="up">[2] THE HOMEPAGE</p>
    <div class="as-window" data-reveal="up" data-asci-window>
      <div class="as-window__bar">
        <span class="as-window__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="as-window__url">asci.co.in</span>
        <span class="as-window__progress" aria-hidden="true"></span>
      </div>
      {/* Focusable so the page inside can be scrolled from the keyboard too. */}
      <div class="as-window__view" tabindex="0" role="region" aria-label="ASCI homepage, scrollable">
        <div class="as-window__page" style={`aspect-ratio: ${homepage.width} / ${homepage.height}`}>
          {
            bands.map((band, i) => (
              <div class="as-band" style={`top: ${band.top}%; height: calc(${band.height}% + 1px)`}>
                <Image
                  src={homepage}
                  alt={i === 0 ? pageAlt : ''}
                  aria-hidden={i === 0 ? undefined : 'true'}
                  style={`transform: translateY(-${band.top}%)`}
                  widths={[760, 1400, 2400]}
                  sizes="(max-width: 900px) 120vw, 78vw"
                  format="webp"
                  loading="eager"
                />
              </div>
            ))
          }
        </div>
      </div>
      <span class="as-window__hint" aria-hidden="true">Scroll <span>↓</span></span>
    </div>
  </section>
</article>

<style lang="scss">
  @use "../../styles/util" as *;

  .as section {
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    gap: u(50);
    align-items: flex-start;
    padding: u(100);
  }

  // --- Brief ------------------------------------------------------------
  .as .as-brief {
    padding-top: u(70);
  }

  .as-brief__body {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: u(80);
    width: 100%;
  }

  .as-lede {
    width: u(680);
    font-size: u(20);
    line-height: 1.3;
    color: var(--body);
  }

  .as-facts {
    display: flex;
    flex-direction: column;
    gap: u(24);
    width: u(400);
  }

  .as-fact {
    display: flex;
    flex-direction: column;
    gap: u(4);
    font-size: u(20);
    line-height: 1.3;

    dt {
      font-weight: 600;
      color: var(--sage);
    }

    dd {
      margin: 0;
      color: var(--ink);
    }
  }

  // --- The homepage ------------------------------------------------------
  .as .as-page {
    padding-top: 0;
  }

  // A browser window with the whole page inside it: a black bar, then a
  // desktop-shaped opening the page scrolls behind.
  .as-window {
    position: relative;
    width: 100%;
    border: 1px solid var(--ink);
    background: var(--white);
  }

  .as-window__bar {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: u(14) u(20);
    font-size: u(13);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink);
  }

  // The window's three buttons, as squares of the site's own colours.
  .as-window__dots {
    display: flex;
    gap: u(6);

    i {
      width: u(10);
      height: u(10);
      background: var(--g-orange);
    }

    i:nth-child(2) {
      background: var(--g-yellow);
    }

    i:nth-child(3) {
      background: var(--g-blue);
    }
  }

  // How far down the page the reader is, drawn along the foot of the bar.
  // --p is set by the script below, 0 at the top and 1 at the bottom.
  .as-window__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: u(3);
    background: var(--g-orange);
    transform: scaleX(var(--p, 0));
    transform-origin: left center;
  }

  .as-window__view {
    aspect-ratio: 16 / 10;
    max-height: 78vh;
    width: 100%;
    overflow-y: auto;
    overscroll-behavior: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--ink) transparent;

    &:focus-visible {
      outline: 2px solid var(--g-orange);
      outline-offset: -2px;
    }

  }

  // The page, as bands of one picture laid end to end. Each band is a window
  // onto the same file, shifted up to its own stretch, and a pixel taller
  // than it needs to be so no hairline shows between it and the next.
  .as-window__page {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .as-band {
    position: absolute;
    left: 0;
    right: 0;
    overflow: hidden;

    img {
      display: block;
      width: 100%;
      height: auto;
    }
  }

  // Sections fade up as the page inside is scrolled to them. `is-in` is set
  // by the script below.
  :global(.js) .as-band {
    opacity: 0;
    translate: 0 u(14);
    transition:
      opacity 800ms var(--ease-out),
      translate 800ms var(--ease-out);
  }

  :global(.js) .as-band.is-in {
    opacity: 1;
    translate: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .as-band {
      opacity: 1;
      translate: none;
      transition: none;
    }
  }

  // A nudge that the window scrolls. It bobs until the page inside has
  // moved, then goes.
  @keyframes as-bob {
    50% {
      transform: translateY(u(4));
    }
  }

  .as-window__hint {
    position: absolute;
    right: u(28);
    bottom: u(20);
    display: flex;
    gap: u(8);
    padding: u(10) u(14);
    font-size: u(12);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink);
    pointer-events: none;
    transition: opacity var(--dur-base) var(--ease-out);

    span {
      animation: as-bob 1600ms var(--ease-inout) infinite;
    }
  }

  .as-window.is-scrolled .as-window__hint {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .as-window__hint span {
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .as section {
      gap: 32px;
      padding: 56px 24px;
    }

    .as .as-page {
      padding: 0 12px 40px;
    }

    .as-page .eyebrow {
      padding: 0 12px;
    }

    // No room for the page's side margins at this width: the picture is
    // widened until they fall outside the window.
    .as-window__view {
      overflow-x: hidden;
    }

    .as-window__page {
      width: 131.6%;
      margin-left: -15.8%;
    }

    .as-window__bar {
      padding: 10px 12px;
      font-size: 10px;
    }

    .as-window__dots {
      gap: 4px;

      i {
        width: 7px;
        height: 7px;
      }
    }

    // Taller than a desktop screen here, so more than a sliver of the page
    // shows at this width.
    .as-window__view {
      aspect-ratio: 4 / 5;
    }

    .as-window__hint {
      right: 12px;
      bottom: 12px;
      gap: 6px;
      padding: 8px 10px;
      font-size: 10px;
    }

    .as-brief__body {
      flex-direction: column;
      gap: 32px;
    }

    .as-lede,
    .as-facts {
      width: 100%;
    }

    .as-lede {
      font-size: 17px;
    }

    .as-fact {
      font-size: 15px;
    }
  }
</style>

<script>
  // The window's scroll position, handed to CSS: --p drives the progress
  // line, and the first movement retires the hint.
  document.querySelectorAll<HTMLElement>('[data-asci-window]').forEach((frame) => {
    const view = frame.querySelector<HTMLElement>('.as-window__view');
    if (!view) return;

    view.addEventListener(
      'scroll',
      () => {
        const max = view.scrollHeight - view.clientHeight;
        frame.style.setProperty('--p', max > 0 ? String(view.scrollTop / max) : '0');
        frame.classList.toggle('is-scrolled', view.scrollTop > 8);
      },
      { passive: true },
    );

    // The page's sections arrive as they are scrolled to inside the window.
    // Nothing starts until the window itself has arrived, so the first screen
    // is seen coming in.
    const bands = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          bands.unobserve(entry.target);
        }
      },
      { root: view, rootMargin: '0px 0px -8% 0px' },
    );
    const start = () => frame.querySelectorAll('.as-band').forEach((band) => bands.observe(band));

    if (frame.hasAttribute('data-revealed')) {
      start();
    } else {
      const arrived = new MutationObserver(() => {
        if (!frame.hasAttribute('data-revealed')) return;
        arrived.disconnect();
        start();
      });
      arrived.observe(frame, { attributes: true, attributeFilter: ['data-revealed'] });
    }
  });
</script>
