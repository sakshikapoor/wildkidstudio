---
// The index. The statement on the left, the services on the right as a
// numbered contents list — each a ruled row, the way a catalogue lists what
// it carries.
const statement = ['Ship', 'the', 'next', 'big', 'idea'];

const services = [
  'UX & UI Design',
  'Brand Design',
  'App Development',
  'AI Integration',
  'Illustrations',
];
---

<section class="index" id="services">
  <div class="section-head" data-reveal="rule">
    <p class="eyebrow">[3] OUR SERVICES</p>
  </div>

  <div class="index__body">
    {/* The statement builds one word at a time, each rising out of its own box. */}
    <h2 class="index__statement">
      {statement.map((word, i) => (
        <span class="index__word" style={`--i: ${i}`} data-reveal="mask">
          <span>{word}</span>
        </span>
      ))}
    </h2>

    <ol class="index__list">
      {services.map((service, i) => (
        <li class="index__row" style={`--i: ${i}`} data-reveal="rule">
          <span class="index__no">{String(i + 1).padStart(2, '0')}</span>
          <span class="index__name">{service}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style lang="scss">
  @use "../styles/util" as *;

  .index {
    display: flex;
    flex-direction: column;
    gap: u(48);
    padding: u(40) u(100) u(160);
  }

  .index__body {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: u(24);
    align-items: start;
  }

  .index__statement {
    grid-column: 1 / span 6;
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.24em;
    max-width: 6.5em;
    font-size: u(124);
    font-weight: var(--weight-display);
    font-stretch: 90%;
    letter-spacing: -0.03em;
    line-height: 0.9;

    // Room below the baseline for the descender of the p, which the mask
    // would otherwise shave off.
    .index__word {
      padding-bottom: 0.08em;
      margin-bottom: -0.08em;
    }
  }

  .index__list {
    grid-column: 7 / span 6;
    list-style: none;
    padding: 0;
    margin: 0;
    border-bottom: var(--rule);
  }

  .index__row {
    display: flex;
    align-items: baseline;
    gap: u(24);
    padding: u(16) 0 u(18);
    border-top: var(--rule);
  }

  .index__no {
    flex-shrink: 0;
    width: u(40);
    font-size: u(15);
    font-weight: 600;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }

  // On hover the name steps in and an accent dot marks the row.
  .index__name {
    position: relative;
    font-size: u(40);
    font-weight: 600;
    font-stretch: 92%;
    letter-spacing: -0.025em;
    line-height: 1.05;
    transition: transform var(--dur-fast) var(--ease-out);

    &::before {
      content: "";
      position: absolute;
      left: u(-22);
      top: 50%;
      width: u(10);
      height: u(10);
      border-radius: 50%;
      background: var(--dot);
      transform: translateY(-50%) scale(0);
      transition: transform var(--dur-fast) cubic-bezier(0.3, 1.6, 0.5, 1);
    }
  }

  .index__row:hover .index__name {
    transform: translateX(u(28));

    &::before {
      transform: translateY(-50%) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .index__name,
    .index__name::before {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .index {
      gap: 28px;
      padding: 24px 24px 88px;
    }

    .index__body {
      display: flex;
      flex-direction: column;
      gap: 36px;
    }

    .index__statement {
      font-size: 56px;
    }

    .index__list {
      width: 100%;
    }

    .index__row {
      gap: 16px;
      padding: 12px 0 14px;
    }

    .index__no {
      width: 28px;
      font-size: 12px;
    }

    .index__name {
      font-size: 24px;

      // The row marker is tapped rather than hovered here, so it needs to
      // read as a deliberate mark at a glance, not a speck.
      &::before {
        left: -18px;
        width: 8px;
        height: 8px;
      }
    }

    .index__row:hover .index__name {
      transform: translateX(20px);
    }
  }
</style>
