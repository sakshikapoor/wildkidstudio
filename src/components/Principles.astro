---
const principles = [
  {
    name: 'Curious',
    body: 'We look everywhere for ideas. Design, technology, culture, nature, games, film, whatever catches our eye. Good ideas rarely stay in one place.',
  },
  {
    name: 'Intent',
    body: 'Nothing is there just because it looks good. Every decision has a reason, from the big idea down to the smallest detail.',
  },
  {
    name: 'Restless',
    body: "We don't settle for the first decent idea. We explore, question and keep pushing until the work feels right.",
  },
  {
    name: 'Human',
    body: 'We design for people first. Clear, useful and enjoyable beats clever for the sake of being clever.',
  },
];
---

<section class="principles" id="principles">
  <div class="section-head" data-reveal="rule">
    <p class="eyebrow">[5] OUR PRINCIPLES</p>
  </div>

  {/*
    A glossary: number, term, definition, each entry on its own ruled row.
    On hover the row is inked in from the bottom and the type flips to
    paper — the entry you are reading, underlined in full.
  */}
  <ol class="principles__list">
    {
      principles.map((principle, i) => (
        <li class="principle" data-reveal="up" style={`--i: ${i}`}>
          <span class="principle__no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="principle__name">{principle.name}</h3>
          <p class="principle__body">{principle.body}</p>
        </li>
      ))
    }
  </ol>
</section>

<style lang="scss">
  @use "../styles/util" as *;

  .principles {
    display: flex;
    flex-direction: column;
    padding: u(40) u(100) u(160);
  }

  .principles__list {
    list-style: none;
    padding: 0;
    margin: u(40) 0 0;
    border-bottom: var(--rule);
  }

  .principle {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: u(24);
    align-items: baseline;
    padding: u(26) u(16) u(30);
    border-top: var(--rule);
    transition: color var(--dur-fast) var(--ease-inout);

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background: var(--ink);
      transform: scaleY(0);
      transform-origin: bottom center;
      transition: transform var(--dur-fast) var(--ease-out);
    }

    &:hover {
      color: var(--paper);
    }

    &:hover::before {
      transform: none;
    }
  }

  .principle__no {
    grid-column: 1;
    font-size: u(15);
    font-weight: 600;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }

  .principle__name {
    grid-column: 2 / span 4;
    font-size: u(56);
    font-weight: var(--weight-display);
    font-stretch: 90%;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .principle__body {
    grid-column: 7 / span 6;
    max-width: 44ch;
    font-size: u(19);
    line-height: 1.4;
    text-wrap: pretty;
  }

  @media (prefers-reduced-motion: reduce) {
    .principle,
    .principle::before {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .principles {
      padding: 24px 24px 88px;
    }

    .principles__list {
      margin-top: 20px;
    }

    .principle {
      grid-template-columns: 32px 1fr;
      row-gap: 10px;
      padding: 18px 0 22px;
    }

    .principle__no {
      font-size: 12px;
    }

    .principle__name {
      grid-column: 2;
      font-size: 32px;
    }

    .principle__body {
      grid-column: 2;
      font-size: 16px;
    }
  }
</style>
