---
// The plates — the work, straight after the cover. Each project is a
// numbered plate showing its cover photograph; a project without one yet
// shows an empty picture box in its place.
//
// Laid out as catalogue spreads on the 12-column grid: plates run in pairs,
// a wide one (7 columns) beside a narrow one (5), with the sides swapping
// every row, and every plate in a row the same height so the captions share
// a line. Six projects make three rows. An odd plate out takes the whole
// row as a banner, so the grid reads as finished at any count — new
// projects in src/data/projects.ts slot into the pattern on their own.
import { Image } from 'astro:assets';
import PicturePlaceholder from './PicturePlaceholder.astro';
import { projects } from '../data/projects';

// How wide each plate renders, following the pattern in the styles below,
// so the browser picks an image file to match rather than always the widest.
const sizesFor = (i: number) => {
  const isBanner = i === projects.length - 1 && i % 2 === 0;
  const isWide = i % 4 === 0 || i % 4 === 3;
  const desktop = isBanner ? 1312 : isWide ? 757 : 531;
  return `(max-width: 900px) calc(100vw - 48px), (max-width: 1512px) ${((desktop / 1512) * 100).toFixed(1)}vw, ${desktop}px`;
};
---

<section class="plates" id="work">
  <div class="section-head" data-reveal="rule">
    <p class="eyebrow">[2] WORK</p>
    <p class="eyebrow">({String(projects.length).padStart(2, '0')})</p>
  </div>

  <div class="plates__grid">
    {
      projects.map((project, i) => (
        <a
          class="plates__item"
          href={`/work/${project.slug}`}
          data-reveal="up"
          style={`--i: ${i % 2}`}
        >
          <p class="plate-caption plates__label">
            <span>Pl. {String(i + 1).padStart(2, '0')}</span>
            {project.year && <span>{project.year}</span>}
          </p>
          <div class="plates__frame">
            {project.cover ? (
              <Image
                class="plates__image"
                src={project.cover}
                alt={project.coverAlt ?? ''}
                widths={[480, 760, 1080, 1520, 2000]}
                sizes={sizesFor(i)}
                formats={['webp']}
                loading={i < 2 ? 'eager' : 'lazy'}
              />
            ) : (
              <PicturePlaceholder />
            )}
          </div>
          <div class="plates__caption">
            <span class="plates__name">{project.name}</span>
            <span class="plates__arrow" aria-hidden="true">↗</span>
          </div>
          <p class="plates__disciplines">{project.disciplines}</p>
        </a>
      ))
    }
  </div>
</section>

<style lang="scss">
  @use "../styles/util" as *;

  .plates {
    display: flex;
    flex-direction: column;
    padding: u(20) u(100) u(160);
  }

  .plates__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: u(56) u(24);
    margin-top: u(32);
  }

  // The spread pattern, four plates to a cycle: wide–narrow, narrow–wide.
  .plates__item:nth-child(4n + 1),
  .plates__item:nth-child(4n + 4) {
    grid-column: span 7;
  }

  .plates__item:nth-child(4n + 2),
  .plates__item:nth-child(4n + 3) {
    grid-column: span 5;
  }

  // The odd one out at the end takes the full row.
  .plates__item:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .plates__item {
    display: flex;
    flex-direction: column;
    min-width: 0;
    text-decoration: none;
    color: var(--ink);
  }

  .plates__label {
    margin: 0 0 u(10);
  }

  // One height for every plate, so a row's two plates and their captions
  // line up whatever their widths. The photograph is cropped into it.
  .plates__frame {
    height: u(500);
    overflow: hidden;
    background: var(--tint);
  }

  .plates__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .plates__item:hover .plates__image,
  .plates__item:focus-visible .plates__image {
    transform: scale(1.03);
  }

  .plates__caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: u(16);
    margin-top: u(18);
  }

  .plates__name {
    font-size: u(48);
    font-weight: var(--weight-display);
    font-stretch: 90%;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  // The arrow takes the accent as it moves off, marking the plate you are on.
  .plates__arrow {
    font-size: u(30);
    font-weight: 600;
    transition:
      transform var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .plates__item:hover .plates__arrow,
  .plates__item:focus-visible .plates__arrow {
    color: var(--dot);
    transform: translate3d(u(5), u(-5), 0);
  }

  .plates__disciplines {
    margin-top: u(8);
    font-size: u(17);
    color: var(--ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .plates__arrow,
    .plates__image {
      transition: none;
    }

    .plates__item:hover .plates__arrow,
    .plates__item:hover .plates__image {
      transform: none;
    }
  }

  // One plate to a row on a handset, each at the same landscape proportion.
  @media (max-width: 900px) {
    .plates {
      padding: 8px 24px 88px;
    }

    .plates__grid {
      display: flex;
      flex-direction: column;
      gap: 48px;
      margin-top: 24px;
    }

    .plates__label {
      margin-bottom: 8px;
    }

    .plates__frame {
      height: auto;
      aspect-ratio: 4 / 3;
    }

    .plates__caption {
      margin-top: 14px;
    }

    .plates__name {
      font-size: 32px;
    }

    .plates__arrow {
      font-size: 22px;
    }

    .plates__disciplines {
      font-size: 15px;
    }
  }
</style>
