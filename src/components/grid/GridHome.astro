---
// The homepage on the page grid: the name, the work, what we do, how we
// engage, what we believe, and the way in. Placement and the shared styles
// are in grid.ts and src/styles/_grid.scss; what is here is homepage-only.
import { Image } from 'astro:assets';
import PicturePlaceholder from '../PicturePlaceholder.astro';
import GridContact from './GridContact.astro';
import { projects } from '../../data/projects';
import { bookingUrl } from '../../data/site';
import admitspot from '../../assets/clients/admitspot.png';
import allenati from '../../assets/clients/allenati.svg';
import asci from '../../assets/clients/asci.png';
import instasupplyLogo from '../../assets/clients/instasupply.svg';
import richapi from '../../assets/clients/richapi.svg';
import texau from '../../assets/clients/texau.svg';
import { place, rows, blockClass, blockStyle, type Area, type Block, type Colour } from './grid';

const intro =
  'An independent design studio in Bengaluru building considered websites and brand systems for companies that want to stand apart, not fit in.';

// --- Cover -------------------------------------------------------------
const coverBlocks: Block[] = [
  { d: [14, 2, 1, 1], m: [7, 6, 1, 1], kind: 'fill', c: 'ink' },
  { d: [17, 4, 1, 1], m: [1, 4, 1, 1], kind: 'fill', c: 'orange' },
  { d: [20, 2, 1, 1], kind: 'fill', c: 'blue' },
  { d: [23, 3, 1, 1], m: [8, 1, 1, 1], kind: 'fill', c: 'yellow' },
];

// --- Work --------------------------------------------------------------
// One slot per project, in order. Add a project and give it a slot here.
const workSlots: { d: Area; m: Area }[] = [
  { d: [2, 3, 10, 7], m: [1, 3, 7, 5] },
  { d: [15, 2, 8, 6], m: [2, 11, 7, 5] },
  { d: [13, 11, 10, 7], m: [1, 19, 7, 5] },
  { d: [3, 13, 8, 6], m: [2, 27, 7, 5] },
  { d: [7, 21, 12, 8], m: [1, 35, 7, 5] },
];

const workBlocks: Block[] = [
];

// --- Clients -----------------------------------------------------------
// Logos differ in shape, so each sets its own height, in squares, to sit at
// about the same weight as the rest.
const clients = [
  { name: 'RichAPI', logo: richapi, h: 0.6 },
  { name: 'Allenati', logo: allenati, h: 0.9 },
  { name: 'InstaSupply', logo: instasupplyLogo, h: 1.15 },
  { name: 'TexAu', logo: texau, h: 0.75 },
  { name: 'ASCI', logo: asci, h: 1.05 },
  { name: 'AdmitSpot', logo: admitspot, h: 0.7 },
];

// Four squares by two each: two rows of three, the second stepped across, or
// two columns on handsets.
const clientArea = (i: number) => {
  const row = Math.floor(i / 3);
  return place(
    [2 + 10 * row + 4 * (i % 3), 3 + 2 * row, 4, 2],
    [1 + 4 * (i % 2), 3 + 2 * Math.floor(i / 2), 4, 2],
  );
};

const clientBlocks: Block[] = [
];

// --- Services ----------------------------------------------------------
const services: { name: string; c: Colour }[] = [
  { name: 'UX & UI Design', c: 'ink' },
  { name: 'Brand Design', c: 'orange' },
  { name: 'UX Audit', c: 'pink' },
  { name: 'App Development', c: 'blue' },
  { name: 'AI Integration', c: 'yellow' },
  { name: 'Illustrations', c: 'ink' },
];

const serviceBlocks: Block[] = [
];

// --- Engage ------------------------------------------------------------
const offers = [
  {
    title: 'Sprint',
    meta: '1–2 weeks',
    body: 'One flow, one feature, or a design audit. A low-risk way to see how we work before a larger commitment.',
    c: 'yellow',
  },
  {
    title: 'Build',
    meta: '6–8 weeks',
    body: 'A defined v1, from design through working frontend and backend, with clear milestones and milestone-based payment.',
    c: 'pink',
  },
  {
    title: 'Retainer',
    meta: 'Ongoing design capacity',
    body: 'Part-time weekly hours for teams that need continuous design-to-shipped-code throughput without a full-time hire.',
    c: 'blue',
  },
] as const;

// Stepped down one square per offer, so the three read as a staircase.
const offerArea = (i: number) => ({
  head: place([2 + 8 * i, 4 + i, 1, 1], [1, 3 + 6 * i, 1, 1]),
  body: place([2 + 8 * i, 5 + i, 6, 4], [1, 4 + 6 * i, 8, 4]),
});

const engageBlocks: Block[] = [
];

// --- Principles --------------------------------------------------------
const principles = [
  {
    name: 'Curious',
    body: 'We look everywhere for ideas. Design, technology, culture, nature, games, film, whatever catches our eye. Good ideas rarely stay in one place.',
    at: [3, 3] as const,
    mark: { kind: 'fill', c: 'orange' },
  },
  {
    name: 'Intent',
    body: 'Nothing is there just because it looks good. Every decision has a reason, from the big idea down to the smallest detail.',
    at: [14, 4] as const,
    mark: { kind: 'fill', c: 'blue' },
  },
  {
    name: 'Restless',
    body: "We don't settle for the first decent idea. We explore, question and keep pushing until the work feels right.",
    at: [6, 8] as const,
    mark: { kind: 'fill', c: 'yellow' },
  },
  {
    name: 'Human',
    body: 'We design for people first. Clear, useful and enjoyable beats clever for the sake of being clever.',
    at: [16, 9] as const,
    mark: { kind: 'fill', c: 'pink' },
  },
] as const;

const principleBlocks: Block[] = [
];

---

<div class="g">
  {/* --- Cover ------------------------------------------------------- */}
  <section class="g__sec g__cover" style={rows(12, 12)}>
    <p class="g__label g__label--plain" style={place([2, 1, 5, 1], [1, 1, 4, 1])}>Est. 2025</p>
    <p class="g__label g__label--plain g__label--end" style={place([17, 1, 6, 1], [4, 1, 4, 1])}>
      Bengaluru, India
    </p>

    <h1 class="g__title" style={place([2, 2, 12, 6], [1, 2, 8, 4])}>
      <span>Wildkid</span>
      <span class="g__title-indent">Studio</span>
    </h1>

    <p class="g__panel g__intro" style={place([16, 7, 8, 3], [1, 8, 8, 3])}>{intro}</p>
    <a class="g__cta" href={bookingUrl} target="_blank" rel="noopener" style={place([16, 10, 4, 1], [5, 11, 4, 1])}>
      Book intro call <span aria-hidden="true">↗</span>
    </a>

    {coverBlocks.map((b, i) => (
      <span class:list={[...blockClass(b), 'g__pop']} style={blockStyle(b, i)} aria-hidden="true" />
    ))}
  </section>

  {/* --- Work -------------------------------------------------------- */}
  <section class="g__sec" id="work" style={rows(30, 43)}>
    <h2 class="g__label" style={place([2, 1, 6, 1], [1, 1, 6, 1])}>
      <span>Selected work</span><span>[1]</span>
    </h2>

    {projects.map((project, i) => {
      const slot = workSlots[i % workSlots.length];
      const [c, r, w, h] = slot.d;
      const [mc, mr, mw, mh] = slot.m;
      return (
        <>
          <a class="g__cover-img" href={`/work/${project.slug}`} style={place(slot.d, slot.m)} data-reveal="up">
            {project.cover ? (
              <Image
                src={project.cover}
                alt={project.coverAlt ?? ''}
                widths={[480, 760, 1080]}
                sizes={`(max-width: 900px) 88vw, ${((w / 24) * 100).toFixed(0)}vw`}
                format="webp"
                loading={i < 2 ? 'eager' : 'lazy'}
              />
            ) : (
              <PicturePlaceholder />
            )}
          </a>
          <a
            class="g__panel g__caption"
            href={`/work/${project.slug}`}
            tabindex="-1"
            style={place([c, r + h, w, 1], [mc, mr + mh, mw, 2])}
          >
            <span class="g__caption-name">{project.name}</span>
            <span class="g__caption-meta">{project.disciplines}</span>
            {project.year && <span class="g__caption-year">{project.year}</span>}
          </a>
        </>
      );
    })}

    {workBlocks.map((b, i) => (
      <span class:list={blockClass(b)} style={blockStyle(b, i)} aria-hidden="true" data-reveal="scale" />
    ))}
  </section>

  {/* --- Clients ----------------------------------------------------- */}
  <section class="g__sec" id="clients" style={rows(8, 10)}>
    <h2 class="g__label" style={place([2, 1, 5, 1], [1, 1, 5, 1])}>
      <span>Clients</span><span>[2]</span>
    </h2>

    <ul class="g__list">
      {clients.map((client, i) => (
        <li class="g__list-row">
          <span class="g__panel g__logo" style={`${clientArea(i)}; --h: ${client.h}`} data-reveal="up">
            <Image src={client.logo} alt={client.name} height={120} loading="lazy" />
          </span>
        </li>
      ))}
    </ul>

    {clientBlocks.map((b, i) => (
      <span class:list={blockClass(b)} style={blockStyle(b, i)} aria-hidden="true" data-reveal="scale" />
    ))}
  </section>

  {/* --- Services ---------------------------------------------------- */}
  <section class="g__sec" id="services" style={rows(9, 14)}>
    <p class="g__label" style={place([2, 1, 5, 1], [1, 1, 5, 1])}>
      <span>Services</span><span>[3]</span>
    </p>

    <h2 class="g__display" style={place([2, 3, 13, 4], [1, 3, 8, 4])}>Ship the next big idea</h2>

    <ol class="g__list">
      {services.map((s, i) => (
        <li class="g__list-row">
          <span
            class:list={['g__block', 'g__block--fill', 'g__no', `g__no--${s.c}`]}
            style={`${place([15, 3 + i, 1, 1], [1, 8 + i, 1, 1])}; --c: var(--g-${s.c})`}
          >
            {i + 1}
          </span>
          <span class="g__panel g__row" style={place([16, 3 + i, 8, 1], [2, 8 + i, 7, 1])}>{s.name}</span>
        </li>
      ))}
    </ol>

    {serviceBlocks.map((b, i) => (
      <span class:list={blockClass(b)} style={blockStyle(b, i)} aria-hidden="true" data-reveal="scale" />
    ))}
  </section>

  {/* --- Engage ------------------------------------------------------ */}
  <section class="g__sec" id="engage" style={rows(12, 20)}>
    <h2 class="g__label" style={place([2, 1, 6, 1], [1, 1, 6, 1])}>
      <span>How we engage</span><span>[4]</span>
    </h2>

    {offers.map((offer, i) => (
      <>
        <span
          class:list={['g__block', 'g__block--fill', 'g__no', `g__no--${offer.c}`]}
          style={`${offerArea(i).head}; --c: var(--g-${offer.c})`}
          aria-hidden="true"
        >
          {i + 1}
        </span>
        <article class="g__panel g__card" style={offerArea(i).body}>
          <h3 class="g__card-title">{offer.title}</h3>
          <p class="g__card-meta">{offer.meta}</p>
          <p>{offer.body}</p>
        </article>
      </>
    ))}

    {engageBlocks.map((b, i) => (
      <span class:list={blockClass(b)} style={blockStyle(b, i)} aria-hidden="true" data-reveal="scale" />
    ))}
  </section>

  {/* --- Principles -------------------------------------------------- */}
  <section class="g__sec" id="principles" style={rows(12, 22)}>
    <h2 class="g__label" style={place([2, 1, 6, 1], [1, 1, 6, 1])}>
      <span>Principles</span><span>[5]</span>
    </h2>

    {principles.map((p, i) => {
      const [c, r] = p.at;
      const mark = { d: [c - 1, r, 1, 1] as Area, m: [1, 3 + 5 * i, 1, 1] as Area, ...p.mark };
      return (
        <>
          <span class:list={blockClass(mark)} style={blockStyle(mark, i)} aria-hidden="true" />
          <div class="g__panel g__card" style={place([c, r, 8, 3], [2, 3 + 5 * i, 7, 4])}>
            <h3 class="g__card-title">{p.name}</h3>
            <p>{p.body}</p>
          </div>
        </>
      );
    })}

    {principleBlocks.map((b, i) => (
      <span class:list={blockClass(b)} style={blockStyle(b, i)} aria-hidden="true" data-reveal="scale" />
    ))}
  </section>

  <GridContact />
</div>

<style lang="scss">
  // Project captions: name, disciplines and year on one row, or two on handsets.
  .g__caption {
    display: flex;
    align-items: center;
    gap: calc(var(--cell) * 0.25);
    padding: 0 calc(var(--cell) * 0.25);
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .g__caption-name {
    font-family: var(--font-display);
    font-size: calc(var(--cell) * 0.32);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .g__caption-meta {
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: calc(var(--cell) * 0.21);
    color: var(--ink-soft);
  }

  .g__caption-year {
    margin-left: auto;
    font-size: calc(var(--cell) * 0.19);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  @media (max-width: 900px) {
    .g__caption {
      display: grid;
      grid-template-columns: 1fr auto;
      align-content: center;
      gap: 2px 12px;
      padding: 0 14px;
    }

    .g__caption-name {
      font-size: 18px;
    }

    .g__caption-meta {
      grid-row: 2;
      font-size: 13px;
    }

    .g__caption-year {
      grid-row: 1;
      grid-column: 2;
      font-size: 11px;
    }
  }
</style>
