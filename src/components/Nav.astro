---
const links = [
  { label: 'Services', href: '/#services' },
  { label: 'Process', href: '/#engage' },
  { label: 'Contact', href: '/#contact' },
  { label: 'About', href: '/about' },
];
---

<header class="nav" data-nav>
  <a class="nav__logo" href="/">WK</a>
  <nav class="nav__links" aria-label="Primary">
    {links.map((link) => <a href={link.href}><span>{link.label}</span></a>)}
  </nav>
  <a class="btn btn--dark nav__email" href="mailto:hello@wildkidstudio.in">
    hello@wildkidstudio.in
  </a>

  {/*
    The handset header. The email address is too long to sit in a 24px gutter,
    so below the breakpoint it moves into this menu along with the links the
    desktop bar shows. Both this button and the panel only appear once the
    document has the `js` class — without scripting the panel could never be
    opened, so the plain links and the email button stay on instead.
  */}
  <button
    class="nav__toggle"
    type="button"
    data-nav-toggle
    aria-expanded="false"
    aria-controls="nav-menu"
    aria-label="Open menu"
  >
    <span class="nav__toggle-bars" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
  </button>

  <div class="nav__menu" id="nav-menu" data-nav-menu>
    <nav class="nav__menu-links" aria-label="Menu">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <a class="btn btn--dark nav__menu-email" href="mailto:hello@wildkidstudio.in">
      hello@wildkidstudio.in
    </a>
  </div>
</header>

<style lang="scss">
  @use "../styles/util" as *;

  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: u(24);
    padding: u(20) u(100);
    background: var(--white);
    backdrop-filter: blur(2px);
    // Set by Motion.astro once the page leaves the top: the bar tightens and
    // picks up a hairline, so it reads as floating over the content.
    transition:
      padding var(--dur-fast) var(--ease-inout),
      box-shadow var(--dur-fast) var(--ease-inout),
      background-color var(--dur-fast) var(--ease-inout);
  }

  .nav.is-scrolled {
    padding-top: u(12);
    padding-bottom: u(12);
    background: rgba(255, 255, 255, 0.86);
    box-shadow: 0 1px 0 rgba(10, 10, 10, 0.08);
  }

  // The mark shifts to the studio's mid-green on hover — the same green the
  // buttons move to.
  .nav__logo {
    transition: color var(--dur-fast) var(--ease-inout);

    &:hover {
      color: var(--band-box);
    }
  }

  // Matched to the email button's width so the links land dead centre.
  .nav__logo {
    width: u(247);
    padding: u(10) 0;
    font-family: var(--font-display);
    font-size: u(30);
    font-weight: var(--weight-display);
    line-height: normal;
    color: var(--logo-green);
    text-decoration: none;
  }

  .nav__links {
    display: flex;
    gap: u(40);
    align-items: center;
    font-size: u(18);
    line-height: normal;
    color: #000000;

    // A rule wipes in from the left on hover and out to the right on
    // release, so the link has a direction rather than just a state.
    a {
      position: relative;
      text-decoration: none;

      span {
        display: inline-block;
        transition: transform var(--dur-fast) var(--ease-out);
      }

      &::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: u(-4);
        width: 100%;
        height: 1px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: right center;
        transition: transform var(--dur-fast) var(--ease-inout);
      }

      &:hover span {
        transform: translateY(u(-2));
      }

      &:hover::after {
        transform: scaleX(1);
        transform-origin: left center;
      }
    }
  }

  // --- The handset menu -------------------------------------------------
  //
  // Both pieces are desktop-hidden and switched on inside the breakpoint
  // below, so nothing here reaches the wide bar.
  .nav__toggle,
  .nav__menu {
    display: none;
  }

  .nav__toggle {
    // 44px of tappable area around a 20px mark.
    width: 44px;
    height: 44px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border: 0;
    background: none;
    cursor: pointer;
    color: var(--ink);
  }

  .nav__toggle-bars {
    position: relative;
    display: block;
    width: 20px;
    height: 14px;

    span {
      position: absolute;
      left: 0;
      width: 100%;
      height: 2px;
      border-radius: 1px;
      background: currentColor;
      transition:
        transform var(--dur-fast) var(--ease-inout),
        opacity var(--dur-fast) var(--ease-inout);
    }

    span:nth-child(1) { top: 0; }
    span:nth-child(2) { top: 6px; }
    span:nth-child(3) { top: 12px; }
  }

  // Open: the outer bars meet in the middle and cross, the middle one goes.
  .nav.is-menu-open .nav__toggle-bars {
    span:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }

    span:nth-child(2) {
      opacity: 0;
    }

    span:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }
  }

  // Anchored to the bar's own bottom edge, so it follows the padding the
  // scrolled state takes away rather than needing its own measurement.
  .nav__menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    flex-direction: column;
    gap: 16px;
    padding: 8px 24px 24px;
    background: var(--white);
    box-shadow: 0 12px 24px rgba(10, 10, 10, 0.1);
    // Only a safety net: five rows fit any handset. A landscape phone with
    // the keyboard up is the case that needs it.
    max-height: calc(100dvh - 100%);
    overflow-y: auto;
    // visibility keeps the closed panel out of the tab order and the
    // accessibility tree without the display:none that would kill the
    // transition.
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out),
      visibility 0s linear var(--dur-fast);
  }

  .nav.is-menu-open .nav__menu {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }

  .nav__menu-links {
    display: flex;
    flex-direction: column;

    a {
      padding: 14px 0;
      font-size: 18px;
      line-height: normal;
      color: var(--ink);
      text-decoration: none;
      border-bottom: 1px solid rgba(10, 10, 10, 0.08);
    }
  }

  .nav__menu-email {
    align-self: flex-start;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav,
    .nav__links a span,
    .nav__links a::after,
    .nav__toggle-bars span,
    .nav__menu {
      transition: none;
    }

    .nav__links a:hover span {
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .nav {
      gap: 16px;
      padding: 16px 24px;
    }

    .nav__logo {
      width: auto;
      font-size: 24px;
    }

    // With scripting, the bar is the mark and the toggle; the links and the
    // email move into the panel. The :global is because `js` sits on <html>,
    // outside this component's scope.
    :global(html.js) .nav__links,
    :global(html.js) .nav__email {
      display: none;
    }

    :global(html.js) .nav__toggle {
      display: inline-flex;
    }

    :global(html.js) .nav__menu {
      display: flex;
    }

    // Without scripting the panel could never be opened, so the bar keeps
    // everything and wraps onto a second row rather than leaving a handset
    // with no navigation at all.
    :global(html:not(.js)) .nav {
      flex-wrap: wrap;
      gap: 12px 16px;
    }

    :global(html:not(.js)) .nav__links {
      gap: 20px;
      font-size: 16px;
    }
  }
</style>

<script>
  // The handset menu. The panel is closed in CSS (visibility: hidden), so
  // everything here is one flag on the header plus the ARIA state that has to
  // agree with it.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = nav?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = nav?.querySelector<HTMLElement>('[data-nav-menu]');

  if (nav && toggle && menu) {
    const isOpen = () => nav.classList.contains('is-menu-open');

    const setOpen = (open: boolean) => {
      nav.classList.toggle('is-menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      // The panel sits over the page, so the page underneath should not
      // scroll behind it.
      document.body.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    // Every link here either jumps to an anchor on this page or leaves for
    // another one. Both mean the menu has done its job.
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !isOpen()) return;
      setOpen(false);
      // Escape should leave focus somewhere sensible rather than on a control
      // that is now invisible.
      toggle.focus();
    });

    // A tap anywhere off the header dismisses it. The toggle's own click has
    // already run by the time this fires, and it is inside the header, so
    // opening does not immediately close again.
    document.addEventListener('click', (event) => {
      if (!isOpen() || nav.contains(event.target as Node)) return;
      setOpen(false);
    });

    // Crossing back to the wide bar hands over to a nav that is always
    // visible. Leaving the flag set would strand the scroll lock.
    window
      .matchMedia('(min-width: 901px)')
      .addEventListener('change', (event) => {
        if (event.matches) setOpen(false);
      });
  }
</script>
