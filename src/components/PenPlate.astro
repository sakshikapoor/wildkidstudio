---
// A catalogue plate: an image redrawn as ballpoint hatching, which draws
// itself in when it scrolls into view. See src/scripts/pen.ts for the engine.
//
// With `colour`, the original photograph opens up through the ink on hover —
// a circle that grows out from the pointer — and on touch screens while the
// plate crosses the middle of the viewport. Without it the plate is ink only.
//
// Without scripting, the <img> is simply shown: the plate degrades to the
// photograph, never to an empty box.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Rendered width in px for the photograph; Astro emits 1x and 2x. */
  width: number;
  /** CSS aspect-ratio of the plate. The image is cropped to it, centred. */
  aspect?: string;
  /**
   * Fill the parent's box instead of holding `aspect` — for grids that set
   * the plate's height themselves. `aspect` then only sizes the image file.
   */
  fit?: boolean;
  /** Reveal the colour photograph on hover. */
  colour?: boolean;
  /** Overrides for the hatching, e.g. { lineCount: 90 }. See pen.ts. */
  pen?: Record<string, number>;
  /** Load eagerly — for a plate above the fold. */
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt,
  width,
  aspect = '4 / 3',
  fit = false,
  colour = false,
  pen = {},
  eager = false,
  class: className,
} = Astro.props;

const [w, h] = aspect.split('/').map((n) => Number(n.trim()));
const height = Math.round((width * h) / w);
---

<figure
  class:list={['plate', { 'plate--fit': fit }, className]}
  data-plate={JSON.stringify(pen)}
  data-colour={colour ? '' : undefined}
  style={fit ? undefined : `aspect-ratio: ${aspect}`}
>
  <canvas class="plate__ink" aria-hidden="true"></canvas>
  <Image
    class="plate__image"
    src={src}
    alt={alt}
    width={width}
    height={height}
    densities={[1, 2]}
    formats={['webp']}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
  />
</figure>

<script>
  import '../scripts/pen';
</script>

<style lang="scss">
  .plate {
    position: relative;
    overflow: hidden;
    margin: 0;
    width: 100%;
    max-width: 100%;
    color: var(--ink);
    background: var(--paper);
  }

  .plate--fit {
    height: 100%;
  }

  // Ink is the canvas's `color` and the stock its background — pen.ts reads
  // both, so the plate is themed from here.
  .plate__ink {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
    background: var(--paper);
  }

  .plate__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  // With scripting the photograph waits under the ink. An ink-only plate
  // keeps it purely as the source and the no-script fallback.
  :global(html.js) .plate:not([data-colour]) .plate__image {
    visibility: hidden;
  }

  // A colour plate holds it behind a closed circle, centred on the pointer,
  // which opens once the drawing has finished.
  :global(html.js) .plate[data-colour] .plate__image {
    clip-path: circle(0% at var(--x, 50%) var(--y, 50%));
    transition: clip-path 900ms var(--ease-out);
  }

  .plate[data-colour][data-inked]:hover .plate__image,
  .plate[data-colour][data-inked].is-centred .plate__image,
  :global(a:hover) .plate[data-colour][data-inked] .plate__image,
  :global(a:focus-visible) .plate[data-colour][data-inked] .plate__image {
    clip-path: circle(150% at var(--x, 50%) var(--y, 50%));
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .plate[data-colour] .plate__image {
      transition: none;
    }
  }
</style>
