---
import Offer from './Offer.astro';
---

{/*
  Three listings side by side, split by vertical rules, in order of size:
  try us, build with us, keep us.
*/}
<section class="engage" id="engage">
  <div class="section-head" data-reveal="rule">
    <p class="eyebrow">[4] HOW WE ENGAGE</p>
  </div>

  <div class="engage__grid">
    <Offer number={1} title="Sprint" meta="1–2 weeks">
      One flow, one feature, or a design audit. A low-risk way to see how we work before a
      larger commitment.
    </Offer>
    <Offer number={2} title="Build" meta="6–8 weeks" delay={1}>
      A defined v1, from design through working frontend and backend, with clear milestones
      and milestone-based payment.
    </Offer>
    <Offer number={3} title="Retainer" meta="Ongoing design capacity" delay={2}>
      Part-time weekly hours for teams that need continuous design-to-shipped-code
      throughput without a full-time hire.
    </Offer>
  </div>
</section>

<style lang="scss">
  @use "../styles/util" as *;

  .engage {
    display: flex;
    flex-direction: column;
    padding: u(40) u(100) u(160);
  }

  .engage__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: var(--rule);

    > :global(*) + :global(*) {
      border-left: var(--rule);
    }

    // The first listing sits flush with the frame edge.
    > :global(:first-child) {
      padding-left: 0;
    }
  }

  @media (max-width: 900px) {
    .engage {
      padding: 24px 24px 88px;
    }

    .engage__grid {
      grid-template-columns: 1fr;

      > :global(*) + :global(*) {
        border-left: 0;
        border-top: var(--rule);
      }
    }
  }
</style>
