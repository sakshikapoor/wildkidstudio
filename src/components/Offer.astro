---
interface Props {
  /** Catalogue number, shown as "No. 01". */
  number: number;
  title: string;
  /** Duration or capacity line, e.g. "1–2 weeks". */
  meta: string;
  /** Position in a staggered group of cards. */
  delay?: number;
}

const { number, title, meta, delay = 0 } = Astro.props;
---

{/*
  One listing in the catalogue: item number, name, a spec tag for the
  duration, then the description.
*/}
<article class="offer" data-reveal="up" style={`--i: ${delay}`}>
  <p class="offer__no">No. {String(number).padStart(2, '0')}</p>
  <h3 class="offer__title">{title}</h3>
  <p class="offer__meta">{meta}</p>
  <p class="offer__body"><slot /></p>
</article>

<style lang="scss">
  @use "../styles/util" as *;

  .offer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
    padding: u(20) u(28) u(40);
  }

  .offer__no {
    font-size: u(15);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .offer__title {
    margin-top: u(64);
    font-family: var(--font-display);
    font-size: u(80);
    font-weight: var(--weight-display);
    font-stretch: 90%;
    letter-spacing: -0.03em;
    line-height: 0.95;
    white-space: nowrap;
  }

  // Set as a tag, like a spec stamped beside a product.
  .offer__meta {
    margin-top: u(20);
    padding: u(5) u(12) u(6);
    font-size: u(15);
    font-weight: 600;
    line-height: 1.1;
    border: var(--rule);
    border-radius: 999px;
  }

  .offer__body {
    margin-top: u(28);
    max-width: 30ch;
    font-size: u(19);
    line-height: 1.4;
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .offer {
      padding: 16px 0 36px;
    }

    .offer__no {
      font-size: 12px;
    }

    .offer__title {
      margin-top: 24px;
      font-size: 48px;
    }

    .offer__meta {
      margin-top: 14px;
      padding: 4px 10px 5px;
      font-size: 13px;
    }

    .offer__body {
      margin-top: 18px;
      max-width: none;
      font-size: 16px;
    }
  }
</style>
