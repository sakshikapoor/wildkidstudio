---
import { bookingUrl } from '../data/site';
---

<section class="cta" id="contact">
  <div class="cta__head">
    {/*
      The spans and the class on the <br> carry no styling of their own — they
      are handles for the breakpoint at the end of the stylesheet, which puts
      each point on its own line and drops the aside. Everything here is
      inline, and the <br> is the same hard break as before, so the wide
      layout renders exactly as it did without them.
    */}
    <p class="cta__intro" data-reveal="up">
      <span class="cta__point">Fixed-scope engagements.</span> <span class="cta__point">Transparent pricing.</span> <span class="cta__point">Weekly working sessions.</span><br class="cta__break">
      <span class="cta__aside">You see the work in progress, not just the polished reveal.</span>
    </p>
    <h2 class="cta__headline" data-reveal="up" style="--i: 1">
      Tell us what you're building
    </h2>
  </div>

  <a
    class="btn btn--hero-light"
    href={bookingUrl}
    target="_blank"
    rel="noopener"
    data-reveal="up"
    style="--i: 2"
  >
    <span>Book Intro Call</span>
  </a>

  <a class="cta__email" href="mailto:hello@wildkidstudio.in" data-reveal="up" style="--i: 3">
    hello@wildkidstudio.in
  </a>
</section>

<style lang="scss">
  @use "../styles/util" as *;

  // The back cover: the one page printed solid, the ink as the ground and the
  // stock showing through as type.
  .cta {
    display: flex;
    flex-direction: column;
    gap: u(56);
    align-items: flex-start;
    padding: u(120) u(100) u(140);
    color: var(--paper);
    background: var(--ink);
  }

  .cta__head {
    display: flex;
    flex-direction: column;
    gap: u(40);
    width: 100%;
  }

  .cta__intro {
    padding-top: u(14);
    font-size: u(19);
    font-weight: 500;
    line-height: 1.4;
    color: var(--tint);
    border-top: var(--rule-w) solid var(--paper);
  }

  .cta__headline {
    max-width: 9em;
    font-size: u(150);
    font-weight: var(--weight-display);
    font-stretch: 90%;
    letter-spacing: -0.03em;
    line-height: 0.9;
    text-wrap: balance;
  }

  // Set large and underlined in the accent, so the address reads as the
  // last line of the page rather than a footnote.
  .cta__email {
    font-size: u(56);
    font-weight: 700;
    font-stretch: 88%;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--paper);
    text-decoration: underline;
    text-decoration-color: var(--dot);
    text-decoration-thickness: u(4);
    text-underline-offset: 0.14em;
    transition: text-underline-offset var(--dur-fast) var(--ease-out);

    &:hover {
      text-underline-offset: 0.24em;
    }
  }

  .cta a:focus-visible {
    outline-color: var(--paper);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta__email {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .cta {
      gap: 36px;
      padding: 72px 24px 88px;
    }

    .cta__head {
      gap: 28px;
    }

    .cta__intro {
      padding-top: 10px;
      font-size: 15px;
    }

    .cta__headline {
      font-size: 56px;
    }

    .cta__email {
      font-size: 24px;
      text-decoration-thickness: 3px;
    }

    // A point to a line. The aside is the first thing to go on a narrow
    // screen — the three points are the promise, and it only elaborates on
    // them. Its hard break goes with it, or it would leave an empty line.
    .cta__point {
      display: block;
    }

    .cta__break,
    .cta__aside {
      display: none;
    }
  }
</style>
