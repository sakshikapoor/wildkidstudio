---
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  /** Numbered label, e.g. "[6] ABOUT". */
  eyebrow: string;
  title: string;
  /** Optional line under the title. */
  meta?: string;
  /** Optional link out to the live product. */
  liveUrl?: string;
  /** Label for that link. */
  liveLabel?: string;
}

const { eyebrow, title, meta, liveUrl, liveLabel } = Astro.props;
---

<header class="page-header">
  <div class="section-head" data-reveal="rule">
    <p class="eyebrow">{eyebrow}</p>
  </div>
  <h1 class="page-header__title" data-reveal="up" style="--i: 1">{title}</h1>
  {meta && <p class="page-header__meta" data-reveal="up" style="--i: 2">{meta}</p>}
  {
    liveUrl && (
      <a
        class="btn btn--dark page-header__live"
        href={liveUrl}
        target="_blank"
        rel="noopener"
        data-reveal="up"
        style="--i: 3"
      >
        <span>{liveLabel}</span>
        <ArrowIcon />
      </a>
    )
  }
</header>

<style lang="scss">
  @use "../styles/util" as *;

  // Mirrors the hero's top spacing: the nav overlays 100px in the Figma
  // frame, and ours is in flow, so the remainder sits here.
  .page-header {
    display: flex;
    flex-direction: column;
    gap: u(20);
    align-items: flex-start;
    padding: u(56) u(100) u(70);
  }

  // The same display voice as the cover wordmark, one step down.
  .page-header__title {
    margin-top: u(24);
    font-family: var(--font-display);
    font-size: u(160);
    font-weight: var(--weight-display);
    font-stretch: 90%;
    letter-spacing: -0.03em;
    line-height: 0.9;
    color: var(--ink);
  }

  // The shared button, with the arrow sitting inside it.
  .page-header__live {
    display: inline-flex;
    align-items: center;
    gap: u(10);
    margin-top: u(10);
  }

  // Matches the showreel's disciplines line.
  .page-header__meta {
    font-size: u(18);
    font-weight: 600;
    line-height: normal;
    color: var(--ink-soft);
  }

  @media (max-width: 900px) {
    .page-header {
      gap: 8px;
      padding: 20px 24px 48px;
    }

    .page-header__title {
      margin-top: 16px;
      font-size: 64px;
    }

    .page-header__meta {
      font-size: 16px;
      font-weight: 500;
    }

    .page-header__live {
      margin-top: 6px;
    }
  }
</style>
