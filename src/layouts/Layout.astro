---
import '../styles/main.scss';
import Motion from '../components/Motion.astro';

interface Props {
  /** Browser tab + og:title. */
  title?: string;
  /** Meta description + og:description. */
  description?: string;
  /** Social share image, relative to site root. */
  ogImage?: string;
}

const {
  title = 'WildKid Studio',
  description = 'A two person studio. We design and build MVPs, internal tools and AI systems.',
  ogImage = '/assets/ogimage.png',
} = Astro.props;

// Absolute URLs — social scrapers do not resolve relative paths.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!--
      Set before the stylesheet so the reveal system's hidden state applies on
      the first paint. Without scripting the class never lands and every
      [data-reveal] element renders normally.
    -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/favicon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph (Facebook, LinkedIn, Slack, iMessage) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WildKid Studio" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="WildKid Studio" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!--
      Both faces are self-hosted from public/fonts/ and declared in
      src/styles/_fonts.scss — no webfont CDN is involved. Preloaded because
      the @font-face rules sit inside the stylesheet, so the browser would
      otherwise only discover them after the CSS has parsed.
    -->
    <link
      rel="preload"
      href="/fonts/BitcountPropDouble-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Jost-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body>
    <slot />
    <Motion />
  </body>
</html>
