---
import { Image, getImage } from 'astro:assets';

import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import GridFlow from '../../components/grid/GridFlow.astro';
import GridContact from '../../components/grid/GridContact.astro';
import { place, rows, blockClass, blockStyle, pad, type Block } from '../../components/grid/grid';
import PicturePlaceholder from '../../components/PicturePlaceholder.astro';
import LiveSite from '../../components/LiveSite.astro';
import InstaSupply from '../../components/casestudy/InstaSupply.astro';
import Allenati from '../../components/casestudy/Allenati.astro';
import Asci from '../../components/casestudy/Asci.astro';
import BookSkim from '../../components/casestudy/BookSkim.astro';
import RichAPI from '../../components/casestudy/RichAPI.astro';
import { projects } from '../../data/projects';

// One route for every project, driven by the same data as the homepage
// plates — so a project added there gets a page for free.
export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, index },
  }));
}

const { project, index } = Astro.props;
const next = projects[(index + 1) % projects.length];

// The cover, cut to the share-card shape. A project with no cover yet falls
// back to the studio's own card.
const ogImage = project.cover
  ? (await getImage({ src: project.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src
  : undefined;

// A domain reads better than a URL on a button, but an app store link needs
// its own wording — so the project can override it.
const liveLabel =
  project.liveLabel ??
  (project.liveUrl && `Visit ${project.liveUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')}`);

// Projects with a written-up case study render their own component in place of
// the generic rows below. The rest still get the placeholder structure.
const caseStudies: Record<string, boolean> = {
  instasupply: true,
  allenati: true,
  asci: true,
  bookskim: true,
  richapi: true,
};
const hasCaseStudy = caseStudies[project.slug] === true;

// Generic rows for a project without its own case-study component. Each
// row only appears once its data exists, so a bare placeholder project shows
// just its brief, and fills out as the entry in projects.ts does.
const sections = [
  { label: 'The brief', body: project.summary },
  project.role && {
    label: 'What we did',
    body: `${project.role}. Working sessions every week, with the client seeing the work as it developed rather than at a single reveal.`,
  },
  { label: 'Outcome', body: 'Case study copy and supporting imagery to come.' },
  project.year && { label: 'Year', body: project.year },
].filter((section): section is { label: string; body: string } => Boolean(section));

// A few squares of colour around the header, the same on every project.
const blocks: Block[] = [
];
---

<Layout
  title={`${project.name} — WildKid Studio`}
  description={project.summary}
  ogImage={ogImage}
>
  <div class="page">
    <Nav />
    <main class="g">
      <section class="g__sec" style={rows(21, 16)}>
        <p class="g__label" style={place([2, 1, 6, 1], [1, 1, 6, 1])}>
          <span>Work</span><span>{pad(index + 1)} / {pad(projects.length)}</span>
        </p>

        <h1 class="g__title project__title" style={place([2, 2, 14, 3], [1, 2, 8, 2])}>
          <span>{project.name}</span>
        </h1>

        <div class="g__panel g__card project__meta" style={place([16, 3, 8, 2], [1, 5, 8, 3])}>
          {project.year && <p class="g__card-meta">{project.year}</p>}
          <p>{project.disciplines}</p>
        </div>

        {
          project.liveUrl && (
            <a class="g__cta" href={project.liveUrl} target="_blank" rel="noopener" style={place([16, 5, 6, 1], [1, 8, 7, 1])}>
              {liveLabel} <span aria-hidden="true">↗</span>
            </a>
          )
        }

        <div class="g__cover-img" style={place([2, 7, 22, 13], [1, 10, 8, 5])}>
          {
            project.cover ? (
              <Image
                src={project.cover}
                alt={project.coverAlt ?? ''}
                widths={[760, 1400, 2200]}
                sizes="(max-width: 900px) 100vw, 92vw"
                format="webp"
                loading="eager"
              />
            ) : (
              <PicturePlaceholder />
            )
          }
        </div>

        {blocks.map((b, i) => <span class:list={[...blockClass(b), 'g__pop']} style={blockStyle(b, i)} aria-hidden="true" />)}
      </section>

      <GridFlow>
        {
          hasCaseStudy ? (
            project.slug === 'instasupply' ? (
              <InstaSupply />
            ) : project.slug === 'allenati' ? (
              <Allenati />
            ) : project.slug === 'bookskim' ? (
              <BookSkim />
            ) : project.slug === 'richapi' ? (
              <RichAPI />
            ) : (
              <Asci />
            )
          ) : (
            <section class="project">
              {project.livePreview && project.liveUrl && (
                <div class="project__live">
                  <LiveSite url={project.liveUrl} title={`${project.name}, the live site`} />
                </div>
              )}
              {sections.map((section, i) => (
                <div class="project__row" data-reveal="up" style={`--i: ${i}`}>
                  <h2 class="project__label">{section.label}</h2>
                  <p class="project__body">{section.body}</p>
                </div>
              ))}
            </section>
          )
        }
      </GridFlow>

      <section class="g__sec" style={rows(6, 6)}>
        <p class="g__label" style={place([2, 2, 5, 1], [1, 2, 5, 1])}>
          <span>Next project</span><span>{pad(((index + 1) % projects.length) + 1)}</span>
        </p>
        <a class="g__panel g__display project__next" href={`/work/${next.slug}`} style={place([2, 3, 14, 2], [1, 3, 8, 2])}>
          <span>{next.name}</span>
          <span class="project__next-arrow" aria-hidden="true">→</span>
        </a>
      </section>

      <GridContact />
    </main>
  </div>
</Layout>

<style lang="scss">
  @use "../../styles/util" as *;

  // A project's name on one line, sized to fit the longest of them.
  .project__meta {
    justify-content: center;
    font-size: calc(var(--cell) * 0.28);
  }

  // The generic write-up, for a project without its own case study: ruled
  // rows, label on the left, copy on the right.
  .project {
    display: flex;
    flex-direction: column;
    padding: u(64) u(64) u(40);
  }

  // The live site, when a project shows one, above its rows. It runs out to
  // the sheet's edges, the full width the cover above it has.
  .project__live {
    margin: u(-64) u(-64) u(64);
  }

  .project__row {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: u(24);
    align-items: baseline;
    padding: u(24) 0 u(28);
    border-top: var(--rule);

    &:last-child {
      border-bottom: var(--rule);
    }
  }

  .project__label {
    grid-column: 1 / span 4;
    font-size: u(15);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project__body {
    grid-column: 6 / span 7;
    max-width: 44ch;
    font-size: u(24);
    font-weight: 500;
    line-height: 1.3;
    text-wrap: pretty;
  }

  // The next project's name, sliding its arrow along on hover.
  .project__next {
    display: flex;
    align-items: center;
    gap: calc(var(--cell) * 0.4);
    padding: 0 calc(var(--cell) * 0.3);
    color: var(--ink);
    text-decoration: none;
    transform: none;
  }

  .project__next-arrow {
    transition: transform 300ms var(--ease-out);
  }

  .project__next:hover .project__next-arrow,
  .project__next:focus-visible .project__next-arrow {
    transform: translateX(calc(var(--cell) * 0.5));
  }

  @media (prefers-reduced-motion: reduce) {
    .project__next-arrow {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .project__title {
      font-size: calc(var(--cell) * 0.85);
    }

    .project__meta {
      font-size: 15px;
    }

    .project {
      padding: 32px 16px 16px;
    }

    .project__live {
      margin: -32px -16px 32px;
    }

    .project__row {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 16px 0 20px;
    }

    .project__label {
      font-size: 12px;
    }

    .project__body {
      font-size: 18px;
    }

    .project__next {
      padding: 0 14px;
    }
  }
</style>
