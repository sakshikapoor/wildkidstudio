---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import GridContact from '../components/grid/GridContact.astro';
import { place, rows, blockClass, blockStyle, type Block, type Colour } from '../components/grid/grid';

// Deliberately short: the work pages carry the detail, so this page only has
// to say who is behind them and where else to find her.
const facts: { label: string; value: string; href?: string; c: Colour }[] = [
  { label: 'Founded', value: '2025', c: 'ink' },
  { label: 'Based in', value: 'Bengaluru, India', c: 'orange' },
  { label: 'Portfolio', value: 'sakshikapoor.com', href: 'https://sakshikapoor.com', c: 'blue' },
  { label: 'LinkedIn', value: '/in/sakshire', href: 'https://linkedin.com/in/sakshire', c: 'yellow' },
  { label: 'Social', value: '@sakshire', href: 'https://instagram.com/sakshire', c: 'pink' },
];

const blocks: Block[] = [
];
---

<Layout
  title="About — WildKid Studio"
  description="An independent design studio in Bengaluru. We design digital products and ship the code."
>
  <div class="page">
    <Nav />
    <main class="g">
      <section class="g__sec" style={rows(14, 19)}>
        <p class="g__label" style={place([2, 1, 6, 1], [1, 1, 6, 1])}>
          <span>About</span><span>Est. 2025</span>
        </p>

        <h1 class="g__title" style={place([2, 2, 12, 6], [1, 2, 8, 4])}>
          <span>The</span>
          <span class="g__title-indent">Studio</span>
        </h1>

        <div class="g__panel g__intro about__intro" style={place([15, 3, 9, 8], [1, 7, 8, 6])}>
          <p>
            An independent design studio in Bengaluru, run by Sakshi Kapoor. Eight years in: she started out in
            frontend engineering, moved across into design, and now does both — which is why the design and the
            code tend to arrive together rather than in a handoff.
          </p>
          <p>
            She also illustrates, and is broadly in the business of acquiring every space that will hold something
            creative. If you want to think an idea through out loud — or hear an unprompted case for one of her
            obsessions, and against one of her dislikes — she is always up for it.
          </p>
        </div>

        <ul class="g__list">
          {
            facts.map((fact, i) => (
              <li class="g__list-row">
                <span
                  class:list={['g__block', 'g__block--fill', 'g__no', `g__no--${fact.c}`]}
                  style={`${place([3, 9 + i, 1, 1], [1, 14 + i, 1, 1])}; --c: var(--g-${fact.c})`}
                  aria-hidden="true"
                />
                {fact.href ? (
                  <a
                    class="g__panel g__row about__link"
                    href={fact.href}
                    target="_blank"
                    rel="noopener"
                    style={place([4, 9 + i, 9, 1], [2, 14 + i, 7, 1])}
                  >
                    <span>{fact.label}</span>
                    <span class="g__row-end">{fact.value} ↗</span>
                  </a>
                ) : (
                  <p class="g__panel g__row" style={place([4, 9 + i, 9, 1], [2, 14 + i, 7, 1])}>
                    <span>{fact.label}</span>
                    <span class="g__row-end">{fact.value}</span>
                  </p>
                )}
              </li>
            ))
          }
        </ul>

        {blocks.map((b, i) => <span class:list={[...blockClass(b), 'g__pop']} style={blockStyle(b, i)} aria-hidden="true" />)}
      </section>

      <GridContact />
    </main>
  </div>
</Layout>

<style lang="scss">
  .about__intro {
    display: flex;
    flex-direction: column;
    gap: 0.9em;
    font-size: calc(var(--cell) * 0.29);
  }

  .about__link {
    color: var(--ink);
    text-decoration: none;

    .g__row-end {
      color: var(--ink);
      text-decoration: underline;
      text-decoration-thickness: 1.5px;
      text-underline-offset: 4px;
    }

    &:hover .g__row-end {
      text-decoration-color: var(--g-orange);
    }
  }

  @media (max-width: 900px) {
    .about__intro {
      font-size: 16px;
    }
  }
</style>
