---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactCta from '../components/ContactCta.astro';

// Deliberately short: the work pages carry the detail, so this page only has
// to say who is behind them and where else to find her.
const facts = [
  { label: 'Founded', value: '2025' },
  { label: 'Based in', value: 'Bengaluru, India' },
];

const links = [
  { label: 'Portfolio', value: 'sakshikapoor.com', href: 'https://sakshikapoor.com' },
  { label: 'LinkedIn', value: '/in/sakshire', href: 'https://linkedin.com/in/sakshire' },
  { label: 'Social', value: '@sakshire', href: 'https://instagram.com/sakshire' },
];
---

<Layout
  title="About — WildKid Studio"
  description="An independent design studio in Bengaluru. We design digital products and ship the code."
>
  <div class="page">
    <Nav />
    <main>
      <PageHeader eyebrow="[5] ABOUT" title="THE STUDIO" meta="Independent since 2025" />

      <section class="about">
        <div class="about__intro">
          <p data-reveal="up">
            An independent design studio in Bengaluru, run by Sakshi Kapoor. Eight years in: she
            started out in frontend engineering, moved across into design, and now does both —
            which is why the design and the code tend to arrive together rather than in a handoff.
          </p>
          <p data-reveal="up" style="--i: 1">
            She also illustrates, and is broadly in the business of acquiring every space that
            will hold something creative. If you want to think an idea through out loud — or hear
            an unprompted case for one of her obsessions, and against one of her dislikes — she is
            always up for it.
          </p>
        </div>

        <dl class="about__meta">
          {
            facts.map((fact, i) => (
              <div class="about__row" data-reveal="left" style={`--i: ${i}`}>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
          {
            links.map((link, i) => (
              <div class="about__row" data-reveal="left" style={`--i: ${i + 2}`}>
                <dt>{link.label}</dt>
                <dd>
                  <a class="about__link" href={link.href} target="_blank" rel="noopener">
                    {link.value}
                  </a>
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <ContactCta />
    </main>
  </div>
</Layout>

<style lang="scss">
  @use "../styles/util" as *;

  .about {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: u(80);
    padding: 0 u(100) u(120);
  }

  .about__intro {
    display: flex;
    flex-direction: column;
    gap: u(20);
    width: u(680);
    font-size: u(20);
    line-height: 1.35;
    color: var(--body);
  }

  .about__meta {
    display: flex;
    flex-direction: column;
    gap: u(20);
    width: u(400);
  }

  .about__row {
    display: flex;
    gap: u(20);
    font-size: u(18);
    line-height: 1.3;

    dt {
      width: u(110);
      flex-shrink: 0;
      font-weight: 600;
      color: var(--sage);
    }

    dd {
      margin: 0;
      color: var(--ink);
    }
  }

  // Same rule-wipe as the nav links, so an outbound link behaves like every
  // other link on the site.
  .about__link {
    position: relative;
    text-decoration: none;

    &::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: u(-3);
      width: 100%;
      height: 1px;
      background: currentColor;
      transform: scaleX(1);
      transform-origin: left center;
      transition: transform var(--dur-fast) var(--ease-inout);
    }

    &:hover::after {
      transform: scaleX(0);
      transform-origin: right center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about__link::after {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .about {
      flex-direction: column;
      gap: 28px;
      padding: 0 24px 72px;
    }

    .about__intro,
    .about__meta {
      width: 100%;
    }

    .about__intro {
      gap: 16px;
      font-size: 16px;
    }

    .about__row {
      font-size: 16px;


      dt {
        width: 92px;
        font-size: 16px;
  
      }
    }
  }
</style>
